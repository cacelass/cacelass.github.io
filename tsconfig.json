{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "rootDir": "js",
    "outDir": "js"
  },
  "include": ["js/**/*.ts"],
  "exclude": ["node_modules"]
}
